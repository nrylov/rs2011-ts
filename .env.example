VOID_HOST=127.0.0.1
VOID_PORT=43594
PORT=8082
# Path to the prepared Void revision 634 cache (none/gzip archives, decrypted maps).
VOID_CACHE_PATH=/absolute/path/to/prepared-cache
# Optional for headless scripts; use a dedicated character.
# VOID_USERNAME=
# VOID_PASSWORD=
# VOID_RSA_MODULUS=

# Gateway service (separate process; role tokens stay in a private JSON file).
# GATEWAY_CONFIG=/absolute/path/to/gateway.config.json
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=7780
# GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:8082
# Remote headless publisher; only this host needs game credentials/cache.
# GATEWAY_URL=ws://127.0.0.1:7780/gateway
# GATEWAY_CLIENT_TOKEN=
# Local agent/CLI credentials (control or observer token for BOT_NAME).
# BOT_NAME=
# GATEWAY_TOKEN=
# GATEWAY_MONITOR_TOKEN=

# Trusted localhost-only browser auto-attachment (enabled by bun run dev:lite).
# BROWSER_GATEWAY_AUTO_ATTACH=1
